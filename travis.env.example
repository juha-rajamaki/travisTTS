# Travis TTS — per-project config
# Place this file at <your-project>/.claude/travis.env
# Any value set here overrides your global ~/.config/travis/travis.env

# Which features are active (on|off)
TRAVIS_STOP_HOOK=on       # Speak Claude's last message when a task finishes
TRAVIS_START_WORK=on      # Say "On it." when Claude starts working
TRAVIS_NAG=on             # Repeat reminders while Claude is idle waiting for you
TRAVIS_ANNOUNCE=on        # Manual claude-announce.sh calls

# Voice: ryan | amy | joe | kristin | alan | jenny | cori | alba
TRAVIS_VOICE=ryan

# Multivoice — assign a different voice to each hook type.
# Default role voices (uncomment to enable multivoice):
#TRAVIS_STOP_VOICE=ryan     # coding  — speaks when Claude finishes a task
#TRAVIS_START_VOICE=jenny   # planning — speaks "On it." when work begins
#TRAVIS_NAG_VOICE=kristin   # waiting  — repeating idle reminders
#TRAVIS_DEPLOY_VOICE=joe    # deploy   — used by deploy-announce.sh

# How many characters of the Stop hook message to speak
TRAVIS_STOP_MAX_CHARS=300

# Nag schedule: space-separated seconds between reminders
CLAUDE_NAG_INTERVALS="60 60 60 300 300 300"

# Do-not-disturb: no speech between these times (24h HH:MM).
# Overnight windows work too (e.g. 22:00 to 08:00).
#TRAVIS_QUIET_FROM=22:00
#TRAVIS_QUIET_TO=08:00

# Active hours: Travis speaks ONLY between these times (24h HH:MM).
# Not set by default = Travis speaks at any time. Overnight windows work too.
# Do-not-disturb above still applies inside active hours.
#TRAVIS_ACTIVE_FROM=08:00
#TRAVIS_ACTIVE_TO=18:00
