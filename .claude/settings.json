{
  "hooks": {
    "Notification": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/waiting-nag.sh start" }] }
    ],
    "UserPromptSubmit": [
      { "matcher": "", "hooks": [
        { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/waiting-nag.sh stop" },
        { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/start-work.sh arm" },
        { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/speak-hook.sh" }
      ]}
    ],
    "PreToolUse": [
      { "matcher": "", "hooks": [
        { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/start-work.sh fire" }
      ]}
    ],
    "SubagentStop": [
      { "matcher": "^(Plan|code-security-auditor)$", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/stop-hook.sh" }] }
    ],
    "Stop": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/stop-hook.sh" }] }
    ]
  }
}
