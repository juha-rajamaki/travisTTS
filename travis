#!/bin/bash

# Travis — voice entry point.
#
# Usage:
#   travis "message"              speak with configured voice
#   travis <number> "message"     speak with a specific voice (1=ryan 2=amy 3=alan 4=jenny 5=kristin 6=joe)
#   travis intro                  play each installed voice saying their introduction line
#   travis intro <name>           play one voice's introduction (e.g. travis intro alan)

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

VOICE_NAMES=(ryan amy alan jenny kristin joe cori alba)

# shellcheck source=travis-config.sh
source "$SCRIPT_DIR/travis-config.sh"

# With multivoice on, a voice that speaks for a role introduces itself by that role.
voice_intro_line() {
    local cap; cap="$(printf '%s' "${1:0:1}" | tr '[:lower:]' '[:upper:]')${1:1}"   # bash 3 (macOS) has no $cap
    case "$(travis_voice_role "$1")" in
        planning) echo "Hi, I'm $cap, the planning voice. I tell you when a plan is ready for you to review." ; return ;;
        coding)   echo "Hi, I'm $cap, the coding voice. I announce when Claude finishes a task, and remind you when Claude is waiting on you." ; return ;;
        security) echo "Hello, I'm $cap, the security voice. I report the findings when the security auditor has reviewed the code." ; return ;;
        deploy)   echo "Hi, I'm $cap, the deployment voice. I tell you when something has been deployed or published." ; return ;;
    esac
    case "$1" in
        ryan)    echo "Hi, I'm Ryan — your default voice. I announce when Claude finishes a task." ;;
        amy)     echo "Hi, I'm Amy. I can be your Travis voice." ;;
        alan)    echo "Hello, I'm Alan. I can be your Travis voice." ;;
        jenny)   echo "Hi, I'm Jenny. I can be your Travis voice." ;;
        kristin) echo "Hi, I'm Kristin. I can be your Travis voice." ;;
        joe)     echo "Hi, I'm Joe. I can be your Travis voice." ;;
        *)       echo "Hello, I am $1. I can be your Travis voice." ;;
    esac
}

VOICE_DIR="$HOME/.local/share/piper/voices"

model_ok() {
    local f="$1"
    [ -f "$f" ] && \
        [ "$(stat -f%z "$f" 2>/dev/null || stat -c%s "$f" 2>/dev/null || echo 0)" -gt 1000000 ]
}

voice_installed() {
    local name="$1"
    case "$name" in
        ryan)    model_ok "$VOICE_DIR/en_US-ryan-high.onnx" || model_ok "$VOICE_DIR/en_US-ryan-medium.onnx" || model_ok "$VOICE_DIR/samuel.onnx" ;;
        amy)     model_ok "$VOICE_DIR/en_US-amy-medium.onnx" ;;
        alan)    model_ok "$VOICE_DIR/en_GB-alan-medium.onnx" ;;
        jenny)   model_ok "$VOICE_DIR/en_GB-jenny_dioco-medium.onnx" ;;
        kristin) model_ok "$VOICE_DIR/en_US-kristin-medium.onnx" ;;
        joe)     model_ok "$VOICE_DIR/en_US-joe-medium.onnx" ;;
        cori)    model_ok "$VOICE_DIR/en_GB-cori-high.onnx" ;;
        alba)    model_ok "$VOICE_DIR/en_GB-alba-medium.onnx" ;;
        *)       false ;;
    esac
}

if [ "${1:-}" = "intro" ]; then
    target="${2:-}"
    if [ -n "$target" ]; then
        # Single voice intro.
        if voice_installed "$target"; then
            "$SCRIPT_DIR/announce.sh" "$(voice_intro_line "$target")" "$target"
        else
            echo "Voice '$target' is not installed. Run: voicemodels.sh --download $target"
            exit 1
        fi
    else
        # All voices intro — play each installed one in order.
        echo ""
        echo "Travis TTS — voice introductions"
        echo "════════════════════════════════"
        printf "  %-10s %-8s %s\n" "ROLE" "VOICE" "SAYS"
        echo ""
        # Role voices first (planning, coding, security, deploy), then the others.
        ordered=()
        for role in planning coding security deploy; do
            v="$(travis_role_voice "$role")"
            [ -n "$v" ] && ordered+=("$v")
        done
        for name in "${VOICE_NAMES[@]}"; do
            [[ " ${ordered[*]} " == *" $name "* ]] || ordered+=("$name")
        done
        for name in "${ordered[@]}"; do
            if voice_installed "$name"; then
                role="$(travis_voice_role "$name")"
                line="$(voice_intro_line "$name")"
                printf "  %-10s %-8s %s\n" "${role:--}" "$name" "$line"
                "$SCRIPT_DIR/announce.sh" "$line" "$name" >/dev/null
            else
                printf "  [%s]  not installed — run: voicemodels.sh --download %s\n" "$name" "$name"
            fi
        done
        echo ""
    fi
    exit 0
fi

if [[ "${1:-}" =~ ^[0-9]+$ ]]; then
    idx=$(( $1 - 1 ))
    VOICE="${VOICE_NAMES[$idx]:-ryan}"
    MESSAGE="${2:-Hello, I am Travis. Your code assistant.}"
else
    VOICE=""   # no number given: use the configured voice (TRAVIS_VOICE, default ryan)
    MESSAGE="${1:-Hello, I am Travis. Your code assistant.}"
fi

"$SCRIPT_DIR/announce.sh" "$MESSAGE" "$VOICE"
